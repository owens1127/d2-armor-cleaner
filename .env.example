# D2 Armor Cleaner — Bungie.net API (https://www.bungie.net/en/Application)
VITE_D2_ARMOR_CLEANER_BUNGIE_API_KEY=
VITE_D2_ARMOR_CLEANER_BUNGIE_CLIENT_ID=
VITE_D2_ARMOR_CLEANER_BUNGIE_CLIENT_SECRET=
VITE_D2_ARMOR_CLEANER_BUNGIE_REDIRECT_URI=https://localhost:5173/oauth/callback

# Legacy names (still supported for one release):
# VITE_BUNGIE_API_KEY=
# VITE_BUNGIE_CLIENT_ID=
# VITE_BUNGIE_CLIENT_SECRET=
# VITE_BUNGIE_REDIRECT_URI=https://localhost:5173/oauth/callback

# DIM Sync API (https://github.com/DestinyItemManager/dim-api)
# Request via POST https://api.destinyitemmanager.com/new_app for localhost dev
VITE_D2_ARMOR_CLEANER_DIM_API_KEY=

# Legacy: VITE_DIM_API_KEY=

# Playwright live E2E — copy dac-bungie-refresh-token from sessionStorage after local sign-in
# (legacy key bungie-refresh-token is migrated automatically)
# E2E_BUNGIE_REFRESH_TOKEN=
